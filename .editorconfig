root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{js,mjs,ts,tsx,jsx,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.toml]
indent_size = 2

[*.md]
# Markdown uses blank lines for structure; trailing spaces are not meaningful
# in this repository and should be removed to keep diffs clean.
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
